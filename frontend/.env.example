# Copy to .env (or set in Vercel > Settings > Environment Variables).
# URL of the FastAPI backend, no trailing slash.
VITE_API_URL=http://127.0.0.1:8000

# Optional: Sentry error tracking for the browser (off when empty)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# Group video meetings (LiveKit). The PUBLIC server URL only, e.g.
# wss://<your-project>.livekit.cloud — the same value as the backend's LIVEKIT_URL.
# Never put the LiveKit API key or secret here: anything VITE_* ends up in the
# browser. When empty, the meeting page says video isn't configured.
VITE_LIVEKIT_URL=
