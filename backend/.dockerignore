# Secrets and local environments must never end up in the image
.env
.env.*
!.env.example
venv/
.venv/
# Caches anywhere in the tree (a bare "__pycache__/" only matches at the root)
**/__pycache__/
**/*.pyc
**/*.pyo
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.git/
Dockerfile
.dockerignore
# Dev/test only
tests/
.coveragerc
pytest.ini
ruff.toml
requirements-dev.txt
