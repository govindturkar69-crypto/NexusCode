# Copy to .env and fill in real values. Never commit .env.

# Frontend origin (CORS + redirect after GitHub OAuth). No trailing slash.
FRONTEND_URL=http://localhost:5173

# Auth: generate with  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Database: either DATABASE_URL (Render style, SSL required by default) ...
DATABASE_URL=
# ... or individual variables (DB_PASSWORD has no default)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=college_project_db
DB_USER=postgres
DB_PASSWORD=
# Optional, e.g. require
DB_SSLMODE=

# AI
GEMINI_API_KEY=

# File storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
