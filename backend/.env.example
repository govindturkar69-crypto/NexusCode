# Copy to .env and fill in real values. Never commit .env.

# Frontend origin (CORS + redirect after GitHub OAuth). No trailing slash.
FRONTEND_URL=http://localhost:5173

# Auth: generate with  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Database: either DATABASE_URL (Render style, SSL required by default) ...
DATABASE_URL=
# ... or individual variables (DB_PASSWORD has no default)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=college_project_db
DB_USER=postgres
DB_PASSWORD=
# Optional, e.g. require
DB_SSLMODE=

# AI (Google Gemini -> aistudio.google.com/apikey). Optional: when empty the app still
# starts, and every AI route answers 503 "AI is not configured" (the UI says so).
GEMINI_API_KEY=
# Optional: a separate Gemini key just for the coding agent, so its small daily
# quota doesn't eat into Explain / Find bugs / Generate docs. Falls back to
# GEMINI_API_KEY when empty, so leaving this blank keeps today's behaviour.
AGENT_GEMINI_API_KEY=

# Email, through Resend (resend.com -> API Keys). Off unless the first two are set.
# Without a verified domain, use onboarding@resend.dev: it only delivers to the
# Resend account owner's own address, which Settings and the logs point out.
RESEND_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=NexusCode

# Sign in with Google: Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth client ID (Web application). Register exactly this redirect URI there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Sign in with GitHub: a separate OAuth app from GITHUB_CLIENT_ID above (that one
# is for pushing code). Scopes used: read:user user:email.
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=
GITHUB_LOGIN_REDIRECT_URI=http://localhost:8000/auth/github/login/callback

# File storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
# Required. Fernet key(s) that encrypt stored GitHub tokens; comma-separate to rotate (new first).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENC_KEY=

# Observability (all optional)
LOG_LEVEL=INFO
# json (default, for log platforms) or text (easier to read locally)
LOG_FORMAT=json
# Sentry error tracking is off unless a DSN is set
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# ---- Group video meetings (LiveKit) ----
# Optional: when any of these is missing the app still runs and the meeting page
# says video isn't configured (POST /projects/{id}/meeting/token answers 503).
# Create a project at cloud.livekit.io: Settings shows the URL, Keys has the
# key/secret. The backend signs short-lived access tokens with the secret; the
# secret never goes to the browser. The frontend also needs the same URL as
# VITE_LIVEKIT_URL (frontend/.env, or Vercel). Use a separate LiveKit project for
# local development so dev and production rooms never mix.
# wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_URL=
# From LiveKit Cloud > Keys. The secret stays here and in Render; never commit it.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
