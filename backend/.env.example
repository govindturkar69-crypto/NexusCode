# Copy to .env and fill in real values. Never commit .env.

# Frontend origin (CORS + redirect after GitHub OAuth). No trailing slash.
FRONTEND_URL=http://localhost:5173

# Auth: generate with  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Database: either DATABASE_URL (Render style, SSL required by default) ...
DATABASE_URL=
# ... or individual variables (DB_PASSWORD has no default)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=college_project_db
DB_USER=postgres
DB_PASSWORD=
# Optional, e.g. require
DB_SSLMODE=

# AI
GEMINI_API_KEY=

# Code execution, through Judge0 on RapidAPI. The Run button stays off until the key is set.
JUDGE0_API_KEY=
# Optional, with these defaults. Raise the limits on a paid Judge0 plan.
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
# RUN_DAILY_LIMIT=45
# RUN_USER_DAILY_LIMIT=15

# File storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
# Required. Fernet key(s) that encrypt stored GitHub tokens; comma-separate to rotate (new first).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENC_KEY=

# Observability (all optional)
LOG_LEVEL=INFO
# json (default, for log platforms) or text (easier to read locally)
LOG_FORMAT=json
# Sentry error tracking is off unless a DSN is set
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
